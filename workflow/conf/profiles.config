profiles {
    local {
        process.executor = 'local'
        docker.runOptions = '--user $(id -u):$(id -g)'

    process.resourceLimits = [
            cpus: 8,
            memory: '16 GB'
        ]
    }
    server {
        process.executor = 'local'
        executor.cpus = 60
        executor.memory = '400 GB'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${projectDir}/containers/cache"
        singularity.runOptions = '--unsquash'
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '--user $(id -u):$(id -g)'
    }
    test {
        includeConfig "${baseDir}/conf/test.config"
    }
}
