manifest {
    name            = 'oxytribe'
    author          = 'fragilefort'
    description     = 'An attempt to make HYPERTRIBE pipeline more usable'
    version         = '0.1.0'
    nextflowVersion = '>=23.0.0'
}

includeConfig 'conf/process.config'
includeConfig 'conf/params.config'
includeConfig 'conf/profiles.config'

outputDir = "${baseDir}/../ChinaTown"
workflow.output.mode = 'rellink'
